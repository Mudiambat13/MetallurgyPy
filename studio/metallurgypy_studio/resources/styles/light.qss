/* MetallurgyPy Studio: light theme. Text/background pairs keep a contrast ratio above 4.5:1. */
QWidget { background: #f6f7f9; color: #1d2733; font-size: 13px; }
QMainWindow, QStackedWidget, QTabWidget::pane { background: #f6f7f9; }

#Sidebar { background: #24323f; border: none; outline: 0; padding-top: 8px; }
#Sidebar::item { color: #e8edf2; padding: 11px 18px; border-left: 3px solid transparent; }
#Sidebar::item:hover { background: #2f4152; }
#Sidebar::item:selected { background: #35495c; border-left: 3px solid #f2a23a; color: #ffffff; }

#TopBar { background: #ffffff; border-bottom: 1px solid #d6dbe1; }
#AppTitle { background: transparent; font-size: 16px; font-weight: 600; }
#StatusLabel { background: transparent; color: #44515f; }
#Notice { background: #fff4df; border: 1px solid #e3b866; border-radius: 4px; padding: 8px; color: #4a3500; }
#ErrorText { background: transparent; color: #a4161a; }
#Hint { background: transparent; color: #44515f; }
#Heading { background: transparent; font-size: 20px; font-weight: 600; }

QPushButton { background: #ffffff; border: 1px solid #aeb6bf; border-radius: 4px; padding: 6px 14px; }
QPushButton:hover { background: #eaf0f6; }
QPushButton:disabled { color: #7b8794; background: #eceff2; }
QPushButton#Primary { background: #1f5f99; color: #ffffff; border: 1px solid #1f5f99; font-weight: 600; }
QPushButton#Primary:hover { background: #184d7d; }

QLineEdit, QComboBox, QSpinBox, QPlainTextEdit, QTextEdit {
    background: #ffffff; border: 1px solid #aeb6bf; border-radius: 4px; padding: 4px 6px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QPlainTextEdit:focus { border: 1px solid #1f5f99; }
QLineEdit[invalid="true"] { border: 1px solid #a4161a; background: #fff1f1; }

QTableWidget, QListWidget, QTreeWidget { background: #ffffff; border: 1px solid #d6dbe1; gridline-color: #e3e7ec; }
QHeaderView::section { background: #e9edf1; border: none; border-bottom: 1px solid #d6dbe1; padding: 6px; font-weight: 600; }
QTabBar::tab { background: #e9edf1; padding: 7px 16px; border: 1px solid #d6dbe1; border-bottom: none; }
QTabBar::tab:selected { background: #ffffff; font-weight: 600; }
QGroupBox { border: 1px solid #d6dbe1; border-radius: 4px; margin-top: 10px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; }
